# ---------------------------------------------------------------------------
# Shrestha Agro Machines — environment configuration
# Copy this file to `.env.local` and fill in the real values.
# Every value is optional: src/config/site.js falls back to the placeholder
# below when the variable is missing, so the site always builds and runs.
# Only VITE_* variables are exposed to the browser bundle — never put secrets here.
# ---------------------------------------------------------------------------

# Brand / identity
VITE_COMPANY_NAME=Shrestha Agro Machines
VITE_COMPANY_SHORT_NAME=SHRESTHA AGRO
VITE_COMPANY_TAGLINE=Agricultural Machinery & Thresher Solutions
VITE_COMPANY_LOCATION=Birtamod, Jhapa, Nepal
VITE_COMPANY_PHONE=+977 98XXXXXXXX
VITE_COMPANY_PHONE_HREF=+9779800000000
VITE_COMPANY_EMAIL=info@shresthaagromachines.com

# Public site URL (used for canonical + Open Graph tags)
VITE_SITE_URL=https://www.shresthaagromachines.com

# Where the "Send Inquiry" form posts to.
# Leave empty to run in local/demo mode (validates + shows confirmation, no network call).
# Django REST example: https://api.shresthaagromachines.com/api/inquiries/
VITE_INQUIRY_ENDPOINT=

# Optional WhatsApp number, international format without "+" or spaces.
VITE_WHATSAPP_NUMBER=9779800000000

# Google Maps embed query for the location panel (address or lat,long).
VITE_MAPS_QUERY=Birtamod, Jhapa, Nepal

# Optional Google Maps embed URL. Paste the src from "Share → Embed a map" to
# replace the styled placeholder map with the real map. Leave empty to keep the
# placeholder (which is what this build ships with).
VITE_MAPS_EMBED_URL=

# Master switch for the WebGL thresher. Set to false to force the image/illustration
# presentation everywhere (useful for very low-powered kiosks or offline demos).
VITE_ENABLE_3D=true
